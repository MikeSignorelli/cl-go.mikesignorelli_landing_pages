# Copy to .env and fill in values from your Supabase project settings.
# These are client-side (VITE_) vars and are embedded in the built bundle.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Zapier "Catch Hook" webhook for direct-from-browser form submissions.
# NOTE: this value ships inside the public client bundle - anyone can read it
# from devtools. Only point this at a Zapier Catch Hook, never anything that
# needs to stay secret.
VITE_ZAPIER_WEBHOOK_URL=""

# Separate Catch Hook webhook for the five-fold-gift quiz (writes to its own
# sheet tab). Same public-bundle caveat as above applies.
VITE_ZAPIER_WEBHOOK_URL_FIVEFOLD=""

# Separate Catch Hook webhook for the pastor-systems-audit quiz (writes to its
# own sheet tab). Same public-bundle caveat as above applies.
VITE_ZAPIER_WEBHOOK_URL_PSA=""

# Server-side proxy project - a Supabase project with a `submit-lead` edge
# function that holds real Zapier webhook URLs as secrets and forwards
# requests, so ad blockers targeting hooks.zapier.com can't drop the lead.
# The publishable key is meant to be public (same tier as a legacy anon key).
VITE_LEADS_SUPABASE_URL=""
VITE_LEADS_SUPABASE_PUBLISHABLE_KEY=""

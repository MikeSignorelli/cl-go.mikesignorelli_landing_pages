# Copy to .env and fill in values from your Supabase project settings.
# These are client-side (VITE_) vars and are embedded in the built bundle.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Every form submission goes through the `submit-lead` edge function on this
# project. It holds the real Zapier webhook URLs as server-side secrets, saves
# the lead to the `leads` table, then forwards it - so no webhook URL ships in
# the browser bundle and an ad blocker targeting hooks.zapier.com cannot drop a
# lead. The publishable key is meant to be public (same tier as a legacy anon key).
#
# The Zapier URLs themselves are NOT set here. They are edge function secrets on
# that Supabase project (Edge Functions -> Secrets), one per destination:
#   ZAPIER_GREECE_WEBHOOK_URL, ZAPIER_PSA_WEBHOOK_URL,
#   ZAPIER_FIVEFOLD_WEBHOOK_URL, ZAPIER_ALL_LEADS_WEBHOOK_URL
VITE_LEADS_SUPABASE_URL=""
VITE_LEADS_SUPABASE_PUBLISHABLE_KEY=""
